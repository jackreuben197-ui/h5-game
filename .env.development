VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=https://test2.awanptest.com
# 主域名，渠道包泛域名解析需要用到，必须配置正确，否则渠道包相关功能无法使用。
VITE_CHANNEL_MAIN_DOMAIN=h5.com
# 本地需要模拟渠道包时，在 .env.local 配置 VITE_CHANNEL_DEV_INVITE_CODE，dev 和本地 build 都会读取。
# VITE_PROXY_IM_TARGET=https://test-impubnub.awanptest.com
# 是否开启原生菜单拦截功能，本地开发环境默认开启（方便调试），生产环境默认关闭。
VITE_NATIVE_MENU_GUARD=open
