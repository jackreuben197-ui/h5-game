{
  "name": "h5-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:i18n": "node scripts/sync-i18n.mjs",
    "sync:protocol": "bash scripts/update_protocol.sh",
    "predev": "pnpm sync:i18n",
    "prebuild": "pnpm sync:i18n",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:debug": "vue-tsc -b && VITE_BUILD_SOURCEMAP=true vite build",
    "build:analyze": "vue-tsc -b && vite build --mode analyze",
    "analyze:report": "pnpm build:analyze && webpack-bundle-analyzer dist/stats.json dist --mode static --report dist/bundle-report.html --no-open",
    "analyze:server": "pnpm build:analyze && webpack-bundle-analyzer dist/stats.json dist",
    "assets:compress": "node scripts/compress-assets.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .vue,.ts,.tsx,.js,.jsx --fix"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.15.0",
    "dayjs": "^1.11.20",
    "@silenthill/agreement-web": "git+ssh://git@github.com/kingofake/agreement-web.git#master",
    "@silenthill/h5-cc-i18n": "github:guysoup027/h5-cc-i18n",
    "google-protobuf": "^3.21.4",
    "@silenthill/h5-cc-bridge": "github:soolary/h5-cc-bridge#main",
    "html2canvas": "^1.4.1",
    "js-md5": "^0.8.3",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode": "^1.5.4",
    "vant": "^4.9.24",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-legacy": "^8.0.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.7.0",
    "sass": "^1.99.0",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "typescript": "~6.0.2",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.6",
    "webpack-bundle-analyzer": "^5.3.0"
  }
}
